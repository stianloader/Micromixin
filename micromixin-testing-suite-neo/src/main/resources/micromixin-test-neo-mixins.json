{
  "required": true,
  "minVersion": "0.8",
  "package": "org.stianloader.micromixin.testneo.testenv.mixins",
  "target": "@env(DEFAULT)",
  "compatibilityLevel": "JAVA_11",
  "mixins": [
    "InjectMixins",
    "InjectMixins$CaptureArgumentsOverflow",
    "InjectMixins$WrongCallbackInfoClass",
    "OverwriteMixins",
    "LocalCaptureMixins",
    "LocalCaptureMixins$NoArgsCaptureInLocalCapture",
    "LocalCaptureMixins$NoArgsCaptureInLocalCaptureUnderflow",
    "LocalCaptureMixins$NoArgsOverflow"
  ]
}
